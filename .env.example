# ── Database ──────────────────────────────────────────────────
# Neon serverless Postgres connection string (same driver as the other apps).
# Arvo tables live under a dedicated Postgres schema named `arvo` — this keeps
# them cleanly separated from the other apps sharing the same Neon account.
DATABASE_URL=

# ── App ───────────────────────────────────────────────────────
# Public base URL of this app (used for absolute links / share URLs).
# Defaults to http://localhost:3102.
APP_BASE_URL=

# Port the dev/start server binds to. Defaults to 3102 (never 3000 = WDA site,
# 3100 = IG app, 3101 = FED).
PORT=

# ── Stripe (TEST MODE ONLY — never a real charge) ───────────────
# Arvo supports two payment options at booking: "pay now" (card via Stripe
# Payment Element) and "pay on the day" (no charge).
#
# To enable the LIVE test-mode card form, paste Stripe TEST keys here:
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_PUBLISHABLE_KEY=pk_test_...
# Standard test card: 4242 4242 4242 4242 / any future expiry / any CVC.
# (3DS test card if you want to exercise it: 4000 0025 0000 3155.)
#
# Without keys the booking page runs in clearly-labelled DEMO mode that lets you
# complete a "pay now" booking with the test card — swap to real keys any time
# with no code change.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
